;
; Programa PIO para WS2812B (NeoPixel)
; Compatível com a matriz 5x5 da BitDogLab
;

.program ws2812
.side_set 1

.wrap_target
bitloop:
    out x, 1       side 0 [6]   ; 7 ciclos com saída em 0, lê próximo bit
    jmp !x do_zero side 1 [3]   ; 4 ciclos em 1 – se 0, vai para do_zero
do_one:
    jmp bitloop    side 1 [4]   ; 5 ciclos em 1 (bit 1: T1H total = 9 ciclos)
do_zero:
    nop            side 0 [4]   ; 5 ciclos em 0 (bit 0: T0L total = 9 ciclos)
.wrap

% c-sdk {
#include "hardware/clocks.h"

static inline void ws2812_program_init(PIO pio, uint sm, uint offset,
                                       uint pin, float freq, bool rgbw) {
    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);

    pio_sm_config c = ws2812_program_get_default_config(offset);
    sm_config_set_sideset_pins(&c, pin);
    sm_config_set_out_shift(&c, false, true, rgbw ? 32 : 24);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    // 10 ciclos por bit: divider = clk_sys / (freq * 10)
    float div = clock_get_hz(clk_sys) / (freq * 10.0f);
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
